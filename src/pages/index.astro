---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const pageTitle =
  "ISOCLARÉ Leadership Scan | Descubre tu punto ciego como líder";
const description =
  "Diagnóstico de liderazgo para descubrir qué está frenando tus resultados y qué cambiar primero en solo 15 minutos.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "ISOCLARÉ",
    url: "https://www.isoclare.com",
    logo: "https://www.isoclare.com/social/isoclare-og.jpg",
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "ISOCLARÉ Leadership Scan",
    description,
    brand: {
      "@type": "Brand",
      name: "ISOCLARÉ",
    },
    image: [
      "https://www.isoclare.com/images/hero-lioness.png",
      "https://www.isoclare.com/images/generated-1776452930800.png",
      "https://www.isoclare.com/images/generated-1776452985783.png",
    ],
    offers: {
      "@type": "Offer",
      priceCurrency: "USD",
      price: "39",
      availability: "https://schema.org/InStock",
      url: "https://www.isoclare.com/",
    },
  },
];

const painPoints = [
  {
    number: "01",
    title: "CUANDO HACER BIEN EL TRABAJO YA NO ES SUFICIENTE",
    description:
      "En entornos ISO y de alto rendimiento, el liderazgo no se sostiene sólo con esfuerzo, experiencia o buena intención, ya que hay ciertas capacidades estructurales que no se enseñan y que si no están conscientes provocan tensiones invisibles, autoridad erosionada, sobre adaptación y decisiones sin respaldo.",
  },
  {
    number: "02",
    title: "NO ES TRABAJAR MÁS, SÍ DOMINAR EL LIDERAZGO ESTRATÉGICO",
    description:
      "Cuando lideras en contextos ISO y de alto rendimiento: Sabes lo que tienes que hacer, pero dudas al momento de sostenerlo. Te adaptas más de lo necesario para evitar conflictos. Te cuesta poner límites sin explicarte de más. Tomas decisiones, pero luego las ajustas para que sean aceptadas. Sientes que debes demostrar constantemente tu capacidad. Esto no se resuelve trabajando más. Se resuelve teniendo un mecanismo claro para decidir y sostener en la práctica.",
  },
  {
    number: "03",
    title: "TRANSFORMA TU LIDERAZGO EN ENTORNOS ISO Y DE ALTO RENDIMIENTO",
    description:
      "El liderazgo efectivo en entornos ISO y de alto rendimiento no depende solo de habilidades. Se sostiene en capacidades estructurales que permiten decidir con claridad, comunicar con precisión y sostener el desempeño sin desgaste innecesario. Estas capacidades no son rasgos de personalidad. Son entrenables cuando existe un criterio claro, por lo tanto, podrás: Potenciar tu influencia, navegar con éxito y cambiar tu vida profesional.",
  },
];

const audienceCircles = [
  "Profesionales ISO de los sistemas de gestión y entornos regulados (ITO, auditora interna/externa, jefa calidad, supervisora, encargada calidad, consultora ISO, HSEC, etc.)",
  "Líderes emergentes que buscan posicionarse y asumir mayor responsabilidad estratégica",
  "Mujeres en industrias de alta exigencia, minería, ingeniería, construcción, salud y más",
  "Directivas que necesitan fortalecer su influencia y sostener decisiones estratégicas",
];

const services = [
  {
    title: "LEADERSHIP SCAN",
    subtitle: "Diagnóstico Perfil de Liderazgo ISO y Alto Rendimiento",
    description:
      "Diagnóstico ejecutivo diseñado para mujeres que necesitan operar con autoridad, claridad y posición en entornos ISO y de alto rendimiento. Permite identificar cómo estás liderando hoy, detectar brechas críticas y obtener un marco claro para ordenar tu liderazgo de forma eficiente y sostenible.",
    soon: false,
  },
  {
    title: "SPEAKING CONFIDENCE",
    subtitle: "Hablar y Presentar en Público con Confianza para Profesionales Técnicos",
    description:
      "Entrenamiento mental para hablar y presentar en público en entornos de alto rendimiento. Entrenamiento mental para comunicar con seguridad incluso bajo presión.",
    soon: false,
  },
  {
    title: "COACHING DE LIDERAZGO BASADO EN EL ESTÁNDAR QUÁ™",
    subtitle: "Para Liderar con Criterio en entornos ISO y de Alto Rendimiento",
    description:
      "Proceso de acompañamiento orientado a desarrollar un liderazgo con criterio, capaz de sostener decisiones bajo presión y demostrar una gestión consistente en entornos regulados y de alto rendimiento, integrando claridad estratégica, autonomía y solidez técnica.",
    soon: true,
  },
  {
    title: "MICROTRAINING ESPECIALIZADO",
    subtitle: "Micro Charlas enfocadas en la Norma ISO 9001/14001 y/o 45001",
    description:
      "Interpretación aplicada de las normas ISO para entender qué exige realmente el sistema, cómo se implementa evitando errores y cómo enfrentamos la realidad de la organización, para entregarte claros y aplicables criterios de gestión.",
    soon: true,
  },
];

const pricingFeatures = [
  "Diagnóstico completo de liderazgo",
  "Reporte personalizado con resultados",
  "Plan de acción con prioridades claras",
  "Acceso inmediato al completar el pago",
];

const authorRoles = [
  "Control Documental",
  "Coordinador QA",
  "Especialista de Calidad",
  "ITO QA",
  "Ingeniero QA",
  "Gerente de Calidad",
  "Jefa de Calidad",
  "Consultor Normas ISO",
];

const authorCredentials = [
  "Psicóloga Organizacional, Universidad Internacional SEK",
  "Auditor Líder en Sistemas de Gestión Integrado ISO 9001 / 45001 / 14001, Bureau Veritas",
  "Diplomada en Gestión y Mejoramiento de Calidad, Pontificia Universidad Católica",
];

const authorSectors = [
  "Minería",
  "OTEC",
  "Ingeniería",
  "Metalmecánica",
  "Transporte",
  "Tapones de corcho",
  "Control de plagas",
];

---

<BaseLayout title={pageTitle} description={description} jsonLd={jsonLd}>
  <header class="hero">
    <div class="container">
      <div class="topbar">
        <a class="brand" href="#hero">ISOCLARÉ</a>
      </div>
      <div class="hero-content" id="hero">
        <div class="hero-copy story-stack">
          <p class="hero-kicker" data-reveal>
            <span class="hero-kicker__line">LIONESS LEADERSHIP™</span>
            <span class="hero-kicker__meta">Cómo liderar con criterio en entornos ISO y de alto rendimiento</span>
          </p>
          <h1 class="hero-title" data-reveal style="--reveal-delay: 120ms;">
            Liderazgo estratégico para mujeres que operan bajo presión.
          </h1>
        </div>
      </div>
    </div>
  </header>

  <section class="section section-alt pain-scroll" data-story="pain">
    <div class="pain-scroll__sticky">
      <div class="container pain-scroll__frame">
        <div class="pain-scroll__cards">
          {painPoints.map((item) => (
            <article class="panel pain-card pain-scroll__card">
              <span class="card-index">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
        <h2 class="section-title pain-scroll__title">Lioness Leadership™</h2>
      </div>
    </div>
    <div class="pain-scroll__track" aria-hidden="true">
      <div class="pain-scroll__step" data-story-step="2"></div>
      <div class="pain-scroll__step" data-story-step="3"></div>
      <div class="pain-scroll__step" data-story-step="4"></div>
    </div>
  </section>

  <section class="section story-section">
    <div class="container split-layout story-shell">
      <div class="image-block image-large" data-reveal>
        <div class="video-placeholder">Video próximamente</div>
      </div>
      <div class="copy-column story-stack">
        <p class="eyebrow" data-reveal>Qué es</p>
        <h2 class="section-title" data-reveal style="--reveal-delay: 120ms;">
          QUÉ ES LIDERAZGO PARA LIONESS LEADERSHIP
        </h2>
        <p class="body-copy" data-reveal style="--reveal-delay: 240ms;">
          El liderazgo no es sólo carisma ni personalidad, es una función estructural.
        </p>
        <p class="body-copy" data-reveal style="--reveal-delay: 300ms;">
          Existe para asegurar coherencia estratégica, dar dirección y sostener la operación en entornos de alto rendimiento y donde el error cuesta.
        </p>
        <p class="body-copy" data-reveal style="--reveal-delay: 360ms;">
          No se trata solo de inspirar, sino de reducir la complejidad, ordenar la toma de decisiones y mantener la cooperación organizacional.
        </p>
        <p class="body-copy" data-reveal style="--reveal-delay: 420ms;">
          Cuando el liderazgo falla, el sistema se descoordina, pero cuando funciona, el desempeño se sostiene.
        </p>
        <div class="enfoque-block" data-reveal style="--reveal-delay: 500ms;">
          <p><strong>Enfoque:</strong> Bajo este enfoque, el liderazgo se trabaja como un sistema que puede diagnosticarse, ajustarse y desarrollarse en función de los estándares y entornos ISO de alto rendimiento.</p>
          <p>Esto implica:</p>
          <ul>
            <li>Diagnosticar cómo está operando el liderazgo dentro del sistema organizacional</li>
            <li>Ajustar los criterios y dinámicas que están afectando la coherencia y la ejecución</li>
            <li>Desarrollar un liderazgo capaz de sostener resultados bajo presión y estándares de alto rendimiento</li>
          </ul>
          <p>No trabajo el liderazgo como una habilidad aislada, sino como una variable crítica del sistema que impacta directamente en los resultados.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt story-section qua-section">
    <div class="container story-shell">
      <p class="eyebrow" data-reveal>Mecanismo QUA™</p>
      <h2 class="section-title" data-reveal style="--reveal-delay: 80ms;">MECANISMO QUA™</h2>
      <p class="section-subtitle" data-reveal style="--reveal-delay: 160ms;">Cómo se Opera el Liderazgo en la Práctica</p>
      <div class="content-narrow">
        <p class="body-copy" data-reveal style="--reveal-delay: 240ms;">
          Para trabajar este enfoque, utilizo el Mecanismo QUA™, que permite ordenar cómo decides y sostienes tu liderazgo en contextos de alta exigencia.
        </p>
        <p class="body-copy" data-reveal style="--reveal-delay: 300ms;">
          No es teoría, es una forma concreta de operar el liderazgo.
        </p>
      </div>
      <div class="qua-diagram" data-reveal style="--reveal-delay: 400ms;">
        <span class="soon-badge">Próximamente</span>
        <span class="qua-mark">QUA™</span>
      </div>
      <p class="qua-footer" data-reveal style="--reveal-delay: 500ms;">
        Sin este mecanismo, el liderazgo depende del contexto · Con el Mecanismo QUA™, el liderazgo se vuelve claro, estructurado y sostenible
      </p>
    </div>
  </section>

  <section class="section section-alt story-section author-section">
    <div class="container split-layout author-layout story-shell">
      <p class="eyebrow author-section-label" data-reveal>Sobre la autora</p>
      <div class="author-copy story-stack">
        <h2 class="section-title author-title-name">MARCELA RODRÍGUEZ SOTOMAYOR</h2>
        <p class="author-lede">20 años liderando y operando desde dentro de los sistemas ISO y de alto rendimiento.</p>
        <p class="body-copy">
          No desde la teoría, sino desde la operación real: Tomando decisiones, sosteniendo procesos y enfrentando las mismas exigencias que hoy viven quienes lideran en estos contextos.
        </p>
        <p class="body-copy">
          Este sistema no nace desde el concepto, sino desde la experiencia aplicada.
        </p>
        <div class="author-meta">
          {authorCredentials.map((item) => <div class="author-meta__item">{item}</div>)}
        </div>
        <div class="author-detail-block">
          <h3>Roles que ha ocupado</h3>
          <ul class="author-list">
            {authorRoles.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="author-detail-block">
          <h3>Sectores en los que ha trabajado</h3>
          <ul class="author-list author-list--compact">
            {authorSectors.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <aside class="author-panel">
                  <div class="author-photo-frame">
                    <img
                      src="/images/author-marcela-marce.jpeg"
                      alt="Marcela Rodríguez"
                      width="853"
                      height="1280"
                      loading="lazy"
                    />
                  </div>
        <div class="author-panel__content">
          <p class="author-panel__eyebrow">MARCELA RODRÍGUEZ SOTOMAYOR</p>
          <h3>Especialista de Calidad</h3>
          <p class="author-panel__text">Psicóloga Organizacional</p>
          <p class="author-panel__text">Auditor Líder Sistema de Gestión Integrado</p>
          <p class="author-panel__text">Diplomada en Gestión y Mejoramiento de la Calidad</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section story-section value-section" data-parallax-section>
    <div class="value-section__backdrop" aria-hidden="true">
      <div class="value-section__texture"></div>
      <div class="value-section__glow"></div>
      <div class="value-section__grid"></div>
    </div>
    <div class="container story-shell value-shell">
      <p class="eyebrow" data-reveal>PROPUESTA DE VALOR</p>
      <h2 class="section-title value-title" data-reveal>
        PROPUESTA ISOCLARÉ
      </h2>
      <p class="section-subtitle value-subtitle" data-reveal style="--reveal-delay: 120ms;">
        Traduzco las capacidades claves del liderazgo en entornos ISO y de alto rendimiento en un marco práctico, aplicable y alineado con la realidad. Porque decidir bajo presión, comunicar con claridad y sostener el desempeño no es opcional.
      </p>
      <div class="three-grid benefits-grid value-grid">
        <article class="panel include-card value-card" data-reveal style="--reveal-delay: 120ms;">
          <h3>QUÉ ES LIONESS LEADERSHIP™</h3>
          <p>Es un sistema de liderazgo diseñado para entornos ISO y de alto rendimiento, donde su foco está en desarrollar:</p>
          <ul>
            <li>El criterio y la capacidad de interpretar la situación</li>
            <li>El definir desde dónde liderar</li>
            <li>La sostenibilidad de las decisiones con claridad y coherencia</li>
            <li>El liderazgo con estructura, intención y dirección</li>
          </ul>
        </article>
        <article class="panel include-card value-card" data-reveal style="--reveal-delay: 260ms;">
          <h3>REGLA CARDINAL - DIAGNOSTICAR Y ORDENAR</h3>
          <p>El liderazgo también ocurre en el cerebro. En entornos exigentes, este interpreta la presión como amenaza, lo que afecta la claridad y la toma de decisiones.</p>
          <p>Por eso, el primer paso no es actuar, es diagnosticar y ordenar.</p>
        </article>
        <article class="panel include-card value-card" data-reveal style="--reveal-delay: 400ms;">
          <h3>QUÉ CAMBIA AL APLICAR EL CRITERIO DEL MODELO LIONESS LEADERSHIP™</h3>
          <p>Cuando aplicas este enfoque:</p>
          <ul>
            <li>Dejas de reaccionar y comienzas a decidir con claridad</li>
            <li>Dejas de explicar y comienzas a sostener</li>
            <li>Dejas de depender de validación externa</li>
            <li>Ordenas tus límites y tu energía</li>
            <li>Te posicionas con más solidez</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt story-section">
    <div class="container split-layout audience-layout story-shell">
      <div class="copy-column story-stack">
        <p class="eyebrow" data-reveal>Para quién es</p>
        <h2 class="section-title" data-reveal style="--reveal-delay: 120ms;">
          PARA QUIÉN ES EL SISTEMA LIONESS LEADERSHIP
        </h2>
        <p class="section-subtitle" data-reveal style="--reveal-delay: 180ms;">
          Este sistema está diseñado para mujeres que lideran en entornos ISO y de alto rendimiento.
        </p>
        <ul class="audience-list">
          {audienceCircles.map((item, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 110 + 260}ms;`}>
              <span>◎</span>
              <p>{item}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="image-block image-tall" data-reveal style="--reveal-delay: 180ms;">
        <img
          src="/images/audience-executive-woman.png"
          alt="Profesional de liderazgo en entornos ISO"
          width="1024"
          height="1536"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section story-section includes-section">
    <div class="includes-section__stage" aria-hidden="true">
      <div class="includes-section__image"></div>
      <div class="includes-section__overlay"></div>
    </div>
    <div class="container story-shell includes-shell">
      <h2 class="section-title includes-title" data-reveal>SERVICIOS DISEÑADOS PARA SOSTENER TU LIDERAZGO EN ENTORNOS ISO Y DE ALTO RENDIMIENTO</h2>
      <div class="four-grid includes-grid">
        {services.map((item, index) => (
          <article
            class="panel include-card includes-card"
            data-reveal
            style={`--reveal-delay: ${index * 110 + 140}ms;`}
          >
            {item.soon && <p class="soon-badge">PRÓXIMAMENTE</p>}
            <h3>{item.title}</h3>
            <p class="service-subtitle">{item.subtitle}</p>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt story-section">
    <div class="container story-shell">
      <div class="content-narrow">
        <h2 class="section-title" data-reveal>ES MOMENTO DE DEJAR DE ASUMIR… Y EMPEZAR A DEMOSTRAR</h2>
        <p class="body-copy" data-reveal style="--reveal-delay: 120ms;">
          Liderar en entornos de alto rendimiento no es sólo cumplir, es sostener un estándar.
        </p>
        <p class="body-copy" data-reveal style="--reveal-delay: 180ms;">
          Esto no es un espacio para aprender más. Es un espacio para dejar de liderar desde la intuición y comenzar a hacerlo con criterio.
        </p>
        <p class="body-copy" data-reveal style="--reveal-delay: 240ms;">
          Aquí no se trata sólo de encajar en un perfil, sino de entenderlo y saber operarlo con criterio.
        </p>
        <p class="body-copy" data-reveal style="--reveal-delay: 300ms;">
          Porque el liderazgo no se declara, el liderazgo se sostiene.
        </p>
        <div class="cta-group" data-reveal style="--reveal-delay: 400ms;">
          <a class="primary-button" href="#hero">Ver mi perfil de Liderazgo Hoy</a>
          <a class="primary-button" href="#hero">Entrenar mi Comunicación Hoy</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section story-section" id="pricing">
    <div class="container pricing-wrap story-shell">
      <p class="eyebrow" data-reveal>Accede ahora</p>
      <h2 class="section-title" data-reveal style="--reveal-delay: 120ms;">Empieza tu leadership scan hoy</h2>
      <p class="section-subtitle" data-reveal style="--reveal-delay: 240ms;">
        15 minutos que pueden cambiar cómo te ves como líder.
      </p>
      <div class="pricing-card" data-reveal style="--reveal-delay: 360ms;">
        <div class="pricing-headline">
          <strong>USD $39</strong>
          <span>/ $35.000 CLP</span>
        </div>
        <div class="pricing-divider"></div>
        <div class="pricing-features">
          {pricingFeatures.map((item) => <div>{item}</div>)}
        </div>
        <a class="primary-button full-width" href="#hero">Acceder al leadership scan</a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-content">
      <p class="footer-link">www.isoclare.com</p>
      <p class="footer-legal">© 2026 ISOCLARÉ · TODOS LOS DERECHOS RESERVADOS</p>
    </div>
  </footer>

  <script>
    const items = Array.from(document.querySelectorAll("[data-reveal]"));
    const storySections = Array.from(document.querySelectorAll("[data-story]"));
    const parallaxSections = Array.from(document.querySelectorAll("[data-parallax-section]"));
    const desktop = window.matchMedia("(min-width: 1025px)");
    let teardownStoryScroll = null;

    const setVisible = (entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
      }
    };

    const boot = () => {
      teardownStoryScroll?.();
      teardownStoryScroll = null;

      items.forEach((item) => item.classList.remove("is-visible"));
      storySections.forEach((section) => {
        section.dataset.activeStep = "0";
      });

      if (!desktop.matches || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        items.forEach((item) => item.classList.add("is-visible"));
        storySections.forEach((section) => {
          section.dataset.activeStep = "4";
        });
        parallaxSections.forEach((section) => {
          section.style.setProperty("--parallax-shift", "0px");
          section.style.setProperty("--parallax-progress", "1");
        });
        return;
      }

      const viewportHeight = window.innerHeight || 1;
      items.forEach((item) => {
        const rect = item.getBoundingClientRect();
        if (rect.top < viewportHeight * 0.92 && rect.bottom > viewportHeight * 0.08) {
          item.classList.add("is-visible");
        }
      });

      const observer = new IntersectionObserver(
        (entries) => entries.forEach(setVisible),
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
      );

      items.forEach((item) => observer.observe(item));

      if (storySections.length || parallaxSections.length) {
        const updateStories = () => {
          storySections.forEach((section) => {
            const rect = section.getBoundingClientRect();
            const viewport = window.innerHeight || 1;
            const total = Math.max(section.offsetHeight - viewport, 1);
            const progress = Math.min(Math.max(-rect.top / total, 0), 1);

            let step = "0";
            if (progress >= 0.06) step = "1";
            if (progress >= 0.22) step = "2";
            if (progress >= 0.4) step = "3";
            if (progress >= 0.58) step = "4";

            section.dataset.activeStep = step;
          });

          parallaxSections.forEach((section) => {
            const rect = section.getBoundingClientRect();
            const viewport = window.innerHeight || 1;
            const progress = ((viewport - rect.top) / (viewport + rect.height));
            const clamped = Math.min(Math.max(progress, 0), 1);
            const shift = (clamped - 0.5) * 220;
            section.style.setProperty("--parallax-shift", `${shift.toFixed(1)}px`);
            section.style.setProperty("--parallax-progress", clamped.toFixed(3));
          });
        };

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateStories();
            ticking = false;
          });
        };

        updateStories();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);

        teardownStoryScroll = () => {
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
        };
      }
    };

    boot();
    desktop.addEventListener?.("change", boot);
  </script>
</BaseLayout>
