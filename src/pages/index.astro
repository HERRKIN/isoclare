---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const pageTitle =
  "ISOCLARÉ Leadership Scan | Descubre tu punto ciego como líder";
const description =
  "Diagnóstico de liderazgo para descubrir qué está frenando tus resultados y qué cambiar primero en solo 15 minutos.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "ISOCLARÉ",
    url: "https://www.isoclare.com",
    logo: "https://www.isoclare.com/social/isoclare-og.jpg",
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "ISOCLARÉ Leadership Scan",
    description,
    brand: {
      "@type": "Brand",
      name: "ISOCLARÉ",
    },
    image: [
      "https://www.isoclare.com/images/hero-lioness.png",
      "https://www.isoclare.com/images/generated-1776452930800.png",
      "https://www.isoclare.com/images/generated-1776452985783.png",
    ],
    offers: {
      "@type": "Offer",
      priceCurrency: "USD",
      price: "39",
      availability: "https://schema.org/InStock",
      url: "https://www.isoclare.com/",
    },
  },
];

const painPoints = [
  {
    number: "01",
    title: "Trabajás más, pero los resultados no cambian",
    description:
      "Sentís que tu esfuerzo no se traduce en impacto real. El equipo no responde como esperás.",
  },
  {
    number: "02",
    title: "Tu experiencia ya no es suficiente",
    description:
      "Lo que te trajo hasta acá no te va a llevar al siguiente nivel. Algo cambió y no sabés qué.",
  },
  {
    number: "03",
    title: "Las decisiones te pesan más que antes",
    description:
      "Cada vez dudás más. El cansancio y la soledad del liderazgo empiezan a notarse.",
  },
];

const benefits = [
  {
    number: "1",
    title: "Claridad",
    description:
      "Sabés exactamente dónde estás parado como líder y qué está frenando tus resultados.",
  },
  {
    number: "2",
    title: "Foco",
    description:
      "Dejás de trabajar en todo y empezás a trabajar en lo que realmente mueve la aguja.",
  },
  {
    number: "3",
    title: "Acción",
    description:
      "Recibís recomendaciones concretas para implementar desde el día uno.",
  },
];

const includes = [
  {
    icon: "✓",
    title: "Evaluación de 360°",
    description:
      "Análisis completo de tu perfil de liderazgo desde múltiples dimensiones.",
  },
  {
    icon: "▤",
    title: "Reporte personalizado",
    description:
      "Informe detallado con tus fortalezas, áreas de mejora y puntos ciegos específicos.",
  },
  {
    icon: "◎",
    title: "Plan de acción",
    description:
      "Recomendaciones concretas y priorizadas para implementar inmediatamente.",
  },
  {
    icon: "✓",
    title: "100% confidencial",
    description:
      "Tus resultados son privados. Solo vos accedés a tu diagnóstico.",
  },
];

const audience = [
  "Liderás equipos y sentís que tu impacto se estancó",
  "Sos emprendedor/a y necesitás tomar mejores decisiones",
  "Querés crecer profesionalmente pero no sabés por dónde empezar",
  "Buscás un diagnóstico honesto, no un test genérico de internet",
];

const pricingFeatures = [
  "Diagnóstico completo de liderazgo",
  "Reporte personalizado con resultados",
  "Plan de acción con prioridades claras",
  "Acceso inmediato al completar el pago",
];

const authorRoles = [
  "Control Documental",
  "Coordinador QA",
  "Especialista de Calidad",
  "ITO QA",
  "Ingeniero QA",
  "Gerente de Calidad",
  "Jefa de Calidad",
  "Consultor Normas ISO",
];

const authorCredentials = [
  "Psicóloga Organizacional, Universidad Internacional SEK",
  "Auditor Líder en Sistemas de Gestión Integrado ISO 9001 / 45001 / 14001, Bureau Veritas",
  "Diplomada en Gestión y Mejoramiento de Calidad, Pontificia Universidad Católica",
];

const authorSectors = [
  "Minería",
  "OTEC",
  "Ingeniería",
  "Metalmecánica",
  "Transporte",
  "Tapones de corcho",
  "Control de plagas",
];

const valueComparison = [
  {
    icon: "cost",
    text: "Un diagnóstico de liderazgo con consultor especializado puede costar entre $150.000 y $500.000 CLP",
  },
  {
    icon: "structure",
    text: "Este instrumento fue diseñado con esa misma lógica profesional, pero optimizado para darte claridad en minutos",
  },
  {
    icon: "focus",
    text: "El objetivo no es inspiración pasajera: es detectar brechas reales de desempeño y liderazgo",
  },
];
---

<BaseLayout title={pageTitle} description={description} jsonLd={jsonLd}>
  <header class="hero">
    <div class="container">
      <div class="topbar">
        <a class="brand" href="#hero">ISOCLARÉ</a>
      </div>
      <div class="hero-content" id="hero">
        <div class="hero-copy story-stack">
          <p class="eyebrow" data-reveal>Diagnóstico de liderazgo</p>
          <h1 class="hero-title" data-reveal style="--reveal-delay: 120ms;">
            Descubre tu punto ciego como líder
          </h1>
          <p class="hero-subtitle" data-reveal style="--reveal-delay: 240ms;">
            El 87% de los líderes no sabe qué lo frena. En 15 minutos, este diagnóstico
            te muestra exactamente dónde estás parado y qué cambiar primero.
          </p>
        </div>
      </div>
    </div>
  </header>

  <section class="section section-alt pain-scroll" data-story="pain">
    <div class="pain-scroll__sticky">
      <div class="container pain-scroll__frame">
        <div class="pain-scroll__cards">
          {painPoints.map((item) => (
            <article class="panel pain-card pain-scroll__card">
              <span class="card-index">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
        <h2 class="section-title pain-scroll__title">¿Te suena familiar?</h2>
      </div>
    </div>
    <div class="pain-scroll__track" aria-hidden="true">
      <div class="pain-scroll__step" data-story-step="2"></div>
      <div class="pain-scroll__step" data-story-step="3"></div>
      <div class="pain-scroll__step" data-story-step="4"></div>
    </div>
  </section>

  <section class="section story-section">
    <div class="container split-layout story-shell">
      <div class="image-block image-large" data-reveal>
        <img
          src="/images/generated-1776452930800.png"
          alt="León coronado representando liderazgo"
          width="832"
          height="693"
          loading="lazy"
        />
      </div>
      <div class="copy-column story-stack">
        <p class="eyebrow" data-reveal>Qué es</p>
        <h2 class="section-title" data-reveal style="--reveal-delay: 120ms;">
          ISOCLARÉ Leadership Scan
        </h2>
        <p class="body-copy" data-reveal style="--reveal-delay: 240ms;">
          Es un diagnóstico estratégico que evalúa tu madurez como líder, tu capacidad
          de construir equipo y tu impacto organizacional.
        </p>
        <p class="body-copy" data-reveal style="--reveal-delay: 360ms;">
          No es un test de personalidad. Es un escaneo de tu liderazgo real, basado en
          psicología organizacional, neurociencia, liderazgo situacional, normas ISO y
          estándares de desempeño.
        </p>
        <div class="highlight-box" data-reveal style="--reveal-delay: 480ms;">
          <span class="highlight-arrow">→</span>
          <p>
            En 15 minutos obtenés un mapa claro de tus fortalezas y puntos ciegos como líder.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt story-section author-section">
    <div class="container split-layout author-layout story-shell">
      <div class="author-copy story-stack">
        <p class="eyebrow">Sobre la autora</p>
        <h2 class="section-title">
          <span class="author-title-name">Marcela Rodríguez</span>
          <span>creó este diagnóstico desde experiencia real en operación</span>
        </h2>
        <p class="body-copy">
          Es psicóloga organizacional y lleva más de 20 años trabajando dentro de
          sistemas donde liderazgo, cumplimiento y criterio son parte del trabajo diario.
        </p>
        <div class="author-meta">
          {authorCredentials.map((item) => <div class="author-meta__item">{item}</div>)}
        </div>
        <div class="author-detail-block">
          <h3>Roles que ha ocupado</h3>
          <ul class="author-list">
            {authorRoles.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="author-detail-block">
          <h3>Sectores en los que ha trabajado</h3>
          <ul class="author-list author-list--compact">
            {authorSectors.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <aside class="author-panel">
        <div class="author-photo-frame">
          <img
            src="/images/author-marcela.png"
            alt="Marcela Rodríguez"
            width="1024"
            height="1536"
            loading="lazy"
          />
        </div>
        <div class="author-panel__content">
          <p class="author-panel__eyebrow">Marcela Rodríguez</p>
          <h3>Psicóloga Organizacional</h3>
          <p class="author-panel__text">
            Más de 20 años trabajando en calidad, liderazgo, implementación y sistemas
            de gestión en entornos exigentes.
          </p>
          <p class="author-panel__text">
            Formación en psicología organizacional, auditoría líder ISO y mejoramiento
            de la calidad.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section story-section value-section" data-parallax-section>
    <div class="value-section__backdrop" aria-hidden="true">
      <div class="value-section__texture"></div>
      <div class="value-section__glow"></div>
      <div class="value-section__grid"></div>
    </div>
    <div class="container story-shell value-shell">
      <p class="eyebrow" data-reveal>Por qué vale más</p>
      <h2 class="section-title value-title" data-reveal>
        ¿Por qué este diagnóstico vale más que un test genérico?
      </h2>
      <p class="section-subtitle value-subtitle" data-reveal style="--reveal-delay: 120ms;">
        Porque no busca entretenerte ni describirte por encima. Busca mostrarte con
        criterio dónde están tus brechas reales de liderazgo y qué hacer primero.
      </p>
      <div class="three-grid benefits-grid value-grid">
        {valueComparison.map((item, index) => (
          <article
            class="panel include-card value-card"
            data-reveal
            style={`--reveal-delay: ${index * 140 + 120}ms;`}
          >
            <div class="include-icon" aria-hidden="true">
              {item.icon === "cost" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="8"></circle>
                  <path d="M12 7v10"></path>
                  <path d="M15 9.5c0-1.1-1.34-2-3-2s-3 .9-3 2 1.34 2 3 2 3 .9 3 2-1.34 2-3 2-3-.9-3-2"></path>
                </svg>
              )}
              {item.icon === "structure" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="5" width="16" height="14" rx="2"></rect>
                  <path d="M8 9h8"></path>
                  <path d="M8 13h5"></path>
                  <path d="M16 12v4"></path>
                </svg>
              )}
              {item.icon === "focus" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="7"></circle>
                  <circle cx="12" cy="12" r="2.5"></circle>
                  <path d="M12 3v2"></path>
                  <path d="M12 19v2"></path>
                  <path d="M3 12h2"></path>
                  <path d="M19 12h2"></path>
                </svg>
              )}
            </div>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt story-section">
    <div class="container story-shell">
      <h2 class="section-title" data-reveal>Qué cambia después del scan</h2>
      <p class="section-subtitle" data-reveal style="--reveal-delay: 120ms;">
        Dejás de adivinar y empezás a liderar con datos concretos.
      </p>
      <div class="three-grid benefits-grid">
        {benefits.map((item, index) => (
          <article
            class="benefit-card"
            data-reveal
            style={`--reveal-delay: ${index * 140 + 220}ms;`}
          >
            <div class="benefit-badge">{item.number}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section story-section includes-section">
    <div class="includes-section__stage" aria-hidden="true">
      <div class="includes-section__image"></div>
      <div class="includes-section__overlay"></div>
    </div>
    <div class="container story-shell includes-shell">
      <h2 class="section-title includes-title" data-reveal>Qué incluye el diagnóstico</h2>
      <div class="four-grid includes-grid">
        {includes.map((item, index) => (
          <article
            class="panel include-card includes-card"
            data-reveal
            style={`--reveal-delay: ${index * 110 + 140}ms;`}
          >
            <div class="include-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt story-section">
    <div class="container split-layout audience-layout story-shell">
      <div class="copy-column story-stack">
        <p class="eyebrow" data-reveal>Para quién es</p>
        <h2 class="section-title" data-reveal style="--reveal-delay: 120ms;">
          Este diagnóstico es para vos si...
        </h2>
        <ul class="audience-list">
          {audience.map((item, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 110 + 220}ms;`}>
              <span>✓</span>
              <p>{item}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="image-block image-tall" data-reveal style="--reveal-delay: 180ms;">
        <img
          src="/images/generated-1776452985783.png"
          alt="Ejecutivo frente a ventanal"
          width="681"
          height="832"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section story-section" id="pricing">
    <div class="container pricing-wrap story-shell">
      <p class="eyebrow" data-reveal>Accedé ahora</p>
      <h2 class="section-title" data-reveal style="--reveal-delay: 120ms;">Empezá tu leadership scan hoy</h2>
      <p class="section-subtitle" data-reveal style="--reveal-delay: 240ms;">
        15 minutos que van a cambiar cómo te ves como líder.
      </p>
      <div class="pricing-card" data-reveal style="--reveal-delay: 360ms;">
        <div class="pricing-headline">
          <strong>USD $39</strong>
          <span>/ $35.000 CLP</span>
        </div>
        <div class="pricing-divider"></div>
        <div class="pricing-features">
          {pricingFeatures.map((item) => <div>{item}</div>)}
        </div>
        <a class="primary-button full-width" href="#hero">Acceder al leadership scan</a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-content">
      <div class="brand footer-brand">ISOCLARÉ</div>
      <p>Diagnóstico Internacional de Liderazgo — Todos los derechos reservados</p>
    </div>
  </footer>

  <script>
    const items = Array.from(document.querySelectorAll("[data-reveal]"));
    const storySections = Array.from(document.querySelectorAll("[data-story]"));
    const parallaxSections = Array.from(document.querySelectorAll("[data-parallax-section]"));
    const desktop = window.matchMedia("(min-width: 1025px)");
    let teardownStoryScroll = null;

    const setVisible = (entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
      }
    };

    const boot = () => {
      teardownStoryScroll?.();
      teardownStoryScroll = null;

      items.forEach((item) => item.classList.remove("is-visible"));
      storySections.forEach((section) => {
        section.dataset.activeStep = "0";
      });

      if (!desktop.matches || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        items.forEach((item) => item.classList.add("is-visible"));
        storySections.forEach((section) => {
          section.dataset.activeStep = "4";
        });
        parallaxSections.forEach((section) => {
          section.style.setProperty("--parallax-shift", "0px");
          section.style.setProperty("--parallax-progress", "1");
        });
        return;
      }

      const viewportHeight = window.innerHeight || 1;
      items.forEach((item) => {
        const rect = item.getBoundingClientRect();
        if (rect.top < viewportHeight * 0.92 && rect.bottom > viewportHeight * 0.08) {
          item.classList.add("is-visible");
        }
      });

      const observer = new IntersectionObserver(
        (entries) => entries.forEach(setVisible),
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
      );

      items.forEach((item) => observer.observe(item));

      if (storySections.length || parallaxSections.length) {
        const updateStories = () => {
          storySections.forEach((section) => {
            const rect = section.getBoundingClientRect();
            const viewport = window.innerHeight || 1;
            const total = Math.max(section.offsetHeight - viewport, 1);
            const progress = Math.min(Math.max(-rect.top / total, 0), 1);

            let step = "0";
            if (progress >= 0.06) step = "1";
            if (progress >= 0.22) step = "2";
            if (progress >= 0.4) step = "3";
            if (progress >= 0.58) step = "4";

            section.dataset.activeStep = step;
          });

          parallaxSections.forEach((section) => {
            const rect = section.getBoundingClientRect();
            const viewport = window.innerHeight || 1;
            const progress = ((viewport - rect.top) / (viewport + rect.height));
            const clamped = Math.min(Math.max(progress, 0), 1);
            const shift = (clamped - 0.5) * 220;
            section.style.setProperty("--parallax-shift", `${shift.toFixed(1)}px`);
            section.style.setProperty("--parallax-progress", clamped.toFixed(3));
          });
        };

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateStories();
            ticking = false;
          });
        };

        updateStories();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);

        teardownStoryScroll = () => {
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
        };
      }
    };

    boot();
    desktop.addEventListener?.("change", boot);
  </script>
</BaseLayout>
